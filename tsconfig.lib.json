{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "importHelpers": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "outDir": "./out-tsc/lib",
    "types": []
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "enableIvy": true,
    "strictInjectionParameters": true,
    "strictTemplates": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
